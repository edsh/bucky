{
  "name": "@edsh-bucky/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "bucky-deelk-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --external:@modelcontextprotocol/sdk --external:zod --outfile=dist/server.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@edsh-bucky/deelk-poh-core": "*",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1"
  }
}
